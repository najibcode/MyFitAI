rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User Profiles & Subcollections ───────────────────────
    // Each user can only read/write their own document and subcollections.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /activities/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /activityGoals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /personalRecords/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /territoryStats/{statId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // ─── Health Data (Steps, Sleep, Recovery) ─────────────────
      // Strictly accessible only to the authenticated owner
      match /health/{healthDoc=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Global Territory Grid Cells ───────────────────────────
    // Partitioned spatial cells (geospatial viewport queries)
    match /territory_cells/{cellId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // ─── Feedback Collection ──────────────────────────────────
    // Authenticated users can create feedback; only they can read their own.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read:   if request.auth != null
                    && resource.data.uid == request.auth.uid;
      // Users cannot update or delete submitted feedback
      allow update, delete: if false;
    }

    // ─── Default Deny ─────────────────────────────────────────
    // Any collection not explicitly matched above is blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
